# Переменные docker compose: шаблон для ./.env в корне репозитория (необязателен локально).
# Настройки приложения — отдельно: backend/.env (шаблон backend/.env.example).

# Пароль PostgreSQL. Только буквы и цифры (он попадает в URL подключения):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Домен для HTTPS (профиль https, Caddy). A-запись домена → IP сервера.
DOMAIN=

# Порт nginx на хосте. С профилем https оставьте только локальный доступ:
WEB_PORT=127.0.0.1:8080
# Old addresses (and www) redirected to DOMAIN, comma-separated, e.g.
# REDIRECT_DOMAINS=www.example.com, 1-2-3-4.sslip.io
REDIRECT_DOMAINS=
