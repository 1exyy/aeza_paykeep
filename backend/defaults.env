# Значения по умолчанию для `docker compose up` — локальный запуск одной командой.
# Всё, что задано в backend/.env, переопределяет эти значения. На сервере backend/.env создаёт
# deploy/vps/configure.sh (свой пароль администратора, HTTPS-адрес, secure-cookie).
# НЕ ИСПОЛЬЗУЙТЕ эти значения на публичном сервере.
DEFAULT_TEAM_NAME=aeza
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin-demo-123
SUPERVISOR_LOGIN=supervisor
SUPERVISOR_PASSWORD=supervisor-demo-123
PUBLIC_BASE_URL=http://localhost:8080
COOKIE_SECURE=false
DEV_MODE=true
SEED_DEMO_DATA=true
APP_TZ_OFFSET=+03:00
