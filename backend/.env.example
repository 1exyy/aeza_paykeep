# Invoice Keeper backend — пример конфигурации. Скопируйте в .env и заполните.
# Секретов здесь нет: пустые значения нужно задать самостоятельно.

# --- База данных ---
# Локальный запуск (uv run ...). В docker compose переопределяется на хост db.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/invoice_keeper
# Только для тестов (pytest):
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/invoice_keeper_test

# --- Администратор (создаётся/обновляется при каждом старте API) ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# Стабильный секрет для шифрования ключей TOTP. Сгенерируйте один раз и сохраните вне Git:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
TOTP_ENCRYPTION_KEY=

# --- Команды ---
# Первая команда: существующие данные и админ выше. Вход: команда + логин + пароль.
DEFAULT_TEAM_NAME=aeza
# Супервайзер: один на сервис, входит с пустым полем «Команда», видит только заявки.
SUPERVISOR_LOGIN=
SUPERVISOR_PASSWORD=
# Бот заявок на новые команды (отдельный бот у @BotFather; токен — только сюда, не в чат).
APPLY_BOT_TOKEN=

# --- Окружение ---
# Адрес, по которому открывают фронт и API (один домен). Используется для проверки Origin.
PUBLIC_BASE_URL=http://localhost:8080
# true — cookie только по HTTPS. Для локального http поставьте false.
COOKIE_SECURE=true
# Dev-часы и /dev/* для демо. На проде false.
DEV_MODE=false
LOG_LEVEL=INFO

# --- Время ---
# Единый часовой пояс системы (фиксированное смещение от UTC). Бизнес-день считается в нём.
APP_TZ_OFFSET=+03:00

# --- Напоминания ---
REMINDER_DAYS_BEFORE=3
REMINDER_SEND_FROM_HOUR=9

# --- Telegram ---
# Токен от @BotFather; chat_id группы — через https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=
MINIAPP_URL=
# Личные напоминания привязанным пользователям (после группового чата).
# Пользователь должен один раз нажать /start у бота, иначе Telegram не даст ему написать.
TELEGRAM_DM_REMINDERS=true
# true — ходить в api.telegram.org только по IPv6 (если хостер режет IPv4 до Telegram).
TELEGRAM_IPV6_ONLY=false
# Таймаут одного запроса к Bot API, секунды.
TELEGRAM_TIMEOUT=25

# --- Email (SMTP), канал включается при SMTP_HOST и EMAIL_RECIPIENTS ---
# Демо: docker compose --profile mail up → SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_STARTTLS=false,
# письма видны на http://localhost:8025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
# Через запятую
EMAIL_RECIPIENTS=

# --- Webhook ---
# Только https:// (http:// допускается при DEV_MODE=true). Демо в docker compose:
# WEBHOOK_URL=http://webhook-sink:9000/hook — сервис логирует события и проверяет подпись.
# Подпись: заголовок X-InvoiceKeeper-Signature: sha256=<HMAC-SHA256(тело, WEBHOOK_SECRET)>.
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- Дополнительный канал: Slack-совместимый incoming webhook ---
# Slack / Mattermost / Rocket.Chat: адрес incoming webhook; Discord: <webhook URL>/slack.
# Только https:// (http:// — при DEV_MODE=true).
EXTRA_CHANNEL_URL=

# --- Вложения (локальный запуск; в docker — volume /data/attachments) ---
ATTACHMENTS_DIR=./data/attachments
